# GradeDex Server — Environment Variables
# Copy to server/.env and fill in values
# Set all of these in Fly.io dashboard → Secrets

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://yezlcgooutpshqdhvufg.supabase.co
SUPABASE_SERVICE_KEY=           # Service role key — never expose to frontend

# ── Redis (Upstash EU) ────────────────────────────────────────────────────────
REDIS_URL=rediss://:<password>@<host>.upstash.io:6380

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_URL=https://<instance>.meilisearch.io
MEILISEARCH_KEY=                # Admin API key

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gradedex-cards
R2_CDN_URL=https://images.gradedex.eu   # Custom domain on R2 bucket

# ── TCG Provider APIs ─────────────────────────────────────────────────────────
PTCG_API_KEY=                   # Optional — pokemontcg.io (higher rate limit)
CARDMARKET_API_KEY=             # RapidAPI key — cardmarket-api1.p.rapidapi.com
TCGAPI_KEY=                     # api.tcgapi.dev

# ── Internal ──────────────────────────────────────────────────────────────────
INTERNAL_SERVICE_KEY=           # Random secret for /admin/* routes
PORT=3001
LOG_LEVEL=info
